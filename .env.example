# Copy to .env (`make setup` does it). Never put AWS access keys or other secrets here.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console

# --- Database (host-side URL; containers override the host to `db`) ---
DATABASE_URL=postgresql+psycopg://northstar:northstar@localhost:5432/northstar

# --- Model providers: fake | ollama | bedrock ---
# fake    = deterministic, offline, free (tests, CI)
# ollama  = local models on your NVIDIA GPU (`make llm-pull` once), free
# bedrock = Amazon Bedrock (costs money; needs account quotas)
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
EMBEDDING_DIMENSIONS=1024

# --- Ollama (local models; containers override the host to `ollama`) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- AWS: credentials come from your AWS CLI SSO profile, not from this file ---
AWS_PROFILE=
AWS_REGION=us-east-1
# Set only after verifying availability and price in your account/region (ADR-0004),
# e.g. us.anthropic.claude-haiku-5-5 (US geo inference profile).
BEDROCK_CHAT_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Uploads, object storage and queue (local: a directory + ElasticMQ; staging: S3 + SQS) ---
STORAGE_ROOT=data/storage
# Empty = ElasticMQ on localhost in local/test (containers use http://sqs:9324). Never AWS.
SQS_ENDPOINT_URL=
INGESTION_QUEUE_NAME=northstar-ingestion
# 20 MB
MAX_UPLOAD_BYTES=20971520

# --- RAG ---
# dense | keyword | hybrid (compare with `make eval-retrieval` before changing)
RAG_RETRIEVAL_MODE=hybrid
RAG_TOP_K=8
RAG_MAX_CONTEXT_TOKENS=3000

# --- Cost guardrails ---
LLM_MAX_OUTPUT_TOKENS=800
# Local model thinks before answering (Qwen3): more accurate on tables, ~10x slower.
LLM_REASONING=false

# --- Agent ---
# false = kill switch: agent endpoints answer 503
AGENT_ENABLED=true
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS_PER_STEP=4
AGENT_TOOL_RESULT_MAX_CHARS=4000
# local | mcp (tools through the read-only MCP server, as a subprocess)
AGENT_TOOL_TRANSPORT=local
# Thinking for the agent's model (Qwen3); measured to fix misread numbers
AGENT_REASONING=true
# "Today" for the agent; the seeded business data is written against 2026-11-15
AGENT_REFERENCE_DATE=2026-11-15
