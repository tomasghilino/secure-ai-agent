# --- Python ---
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
# Local development token issuer (`make token`)
.auth/

# --- Local data (regenerated deterministically) ---
data/storage/*
!data/storage/.gitkeep
data/generated/*
!data/generated/.gitkeep

# --- Evaluation run outputs (curated results live in docs/benchmarks) ---
reports/

# --- Terraform (local state for a disposable environment: never commit it) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.tfvars
!*.tfvars.example

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Claude Code local settings ---
.claude/settings.local.json
